generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Users & roles
// ─────────────────────────────────────────────

enum Role {
  BUYER
  DESIGNER
  PRINTER_OWNER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles           UserRole[]
  designerProfile DesignerProfile?
  printerProfile  PrinterProfile?
  orders          Order[]
  reviews         Review[]
  interactions    ModelInteraction[]

  followersOf     Follow[]       @relation("FollowingRelation")
  following       Follow[]       @relation("FollowerRelation")
  stars           Star[]
  licenseRequests LicenseGrant[]
  activities      Activity[]

  @@map("users")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model DesignerProfile {
  userId         String  @id
  bio            String?
  portfolioUrl   String?
  payoutAccountId String? // Stripe Connect account id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  models         Model3D[]

  @@map("designer_profiles")
}

model PrinterProfile {
  userId             String   @id
  printerModel       String?
  buildVolumeXMm     Float?
  buildVolumeYMm     Float?
  buildVolumeZMm     Float?
  materialsSupported String[]
  // NOTE: true geo queries need PostGIS + a `geography(Point)` column.
  // Prisma doesn't model PostGIS types natively yet, so lat/lng are kept
  // as plain floats here and a raw-SQL migration adds the geography
  // column + spatial index separately (see migrations/README).
  latitude           Float?
  longitude          Float?
  avgTurnaroundDays  Float?
  rating             Float?   @default(0)
  isVerified         Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  printJobs          PrintJob[]

  @@map("printer_profiles")
}

// ─────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────

enum ModelStatus {
  DRAFT
  LIVE
  FLAGGED
  ARCHIVED
}

enum LicenseType {
  PERSONAL_USE
  COMMERCIAL_USE
  EXCLUSIVE
}

model Model3D {
  id           String      @id @default(uuid())
  designerId   String
  title        String
  description  String
  tags         String[]
  category     String
  fileKey      String      // S3 object key for the source .glb/.stl/.obj
  thumbnailKey String?
  fileFormat   String
  volumeMm3    Float?
  boundingBoxX Float?
  boundingBoxY Float?
  boundingBoxZ Float?
  priceBase    Decimal     @db.Decimal(10, 2)
  licenseType  LicenseType @default(PERSONAL_USE)
  status       ModelStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  designer     DesignerProfile   @relation(fields: [designerId], references: [userId])
  variants     ModelVariant[]
  orders       Order[]
  reviews      Review[]
  interactions ModelInteraction[]

  stars         Star[]
  licenseGrants LicenseGrant[]
  activities    Activity[]

  @@index([category])
  @@index([status])
  @@map("models_3d")
}

model ModelVariant {
  id             String  @id @default(uuid())
  modelId        String
  material       String
  color          String
  scalePercent   Float   @default(100)
  priceModifier  Decimal @db.Decimal(10, 2) @default(0)

  model  Model3D @relation(fields: [modelId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("model_variants")
}

// ─────────────────────────────────────────────
// Orders, payments, print jobs
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  MATCHED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
}

model Order {
  id                    String      @id @default(uuid())
  buyerId               String
  modelId               String
  variantId             String?
  status                OrderStatus @default(PENDING)
  quantity              Int         @default(1)
  estimatedPrintTimeMin Int?
  estimatedCost         Decimal?    @db.Decimal(10, 2)
  finalCost             Decimal?    @db.Decimal(10, 2)
  shippingAddress       Json
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  buyer     User          @relation(fields: [buyerId], references: [id])
  model     Model3D       @relation(fields: [modelId], references: [id])
  variant   ModelVariant? @relation(fields: [variantId], references: [id])
  payment   Payment?
  printJob  PrintJob?
  review    Review?

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PAID
  REFUNDED
  FAILED
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  stripePaymentIntentId String?
  amount                Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @db.Decimal(10, 2)
  designerPayout        Decimal       @db.Decimal(10, 2)
  printerPayout         Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  createdAt             DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model PrintJob {
  id             String    @id @default(uuid())
  orderId        String    @unique
  printerId      String
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?

  order   Order          @relation(fields: [orderId], references: [id])
  printer PrinterProfile @relation(fields: [printerId], references: [userId])
  outcome PrintJobOutcome?

  @@map("print_jobs")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  reviewerId String
  targetType String // "model" | "printer"
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  order    Order   @relation(fields: [orderId], references: [id])
  reviewer User    @relation(fields: [reviewerId], references: [id])
  model    Model3D? @relation(fields: [modelId], references: [id])
  modelId  String?

  @@map("reviews")
}

// ─────────────────────────────────────────────
// ML support tables
// ─────────────────────────────────────────────

model ModelInteraction {
  id        String   @id @default(uuid())
  userId    String
  modelId   String
  eventType String // "view" | "search_click" | "add_to_cart" | "purchase"
  ts        DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id])
  model Model3D @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([modelId])
  @@map("model_interactions")
}

model PrintJobOutcome {
  id                String  @id @default(uuid())
  printJobId        String  @unique
  predictedTimeMin  Int?
  actualTimeMin     Int?
  predictedCost     Decimal? @db.Decimal(10, 2)
  actualCost        Decimal? @db.Decimal(10, 2)
  material          String?
  infillPercent     Float?
  layerHeightMm     Float?

  printJob PrintJob @relation(fields: [printJobId], references: [id])

  @@map("print_job_outcomes")
}

// ─────────────────────────────────────────────
// Social layer — following, stars, license grants, activity feed
// ─────────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String   // the user doing the following
  followingId String   // the designer being followed
  createdAt   DateTime @default(now())

  follower  User @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Star {
  id        String   @id @default(uuid())
  userId    String
  modelId   String
  createdAt DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  model Model3D @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@map("stars")
}

enum LicenseGrantStatus {
  PENDING
  APPROVED
  REVOKED
  DECLINED
}

// A "lend" request: another designer asks to use this model in their
// own print jobs. The model stays in the original designer's repo —
// this just grants permission, it's not a copy.
model LicenseGrant {
  id          String             @id @default(uuid())
  modelId     String
  requesterId String
  status      LicenseGrantStatus @default(PENDING)
  message     String?
  createdAt   DateTime           @default(now())
  respondedAt DateTime?

  model     Model3D @relation(fields: [modelId], references: [id], onDelete: Cascade)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([modelId, requesterId])
  @@map("license_grants")
}

enum ActivityType {
  MODEL_PUBLISHED
  MODEL_STARRED
  FOLLOW
}

// Feed entries generated when something feed-worthy happens. Kept
// generic (a type + actor + optional model) rather than one table per
// event type, since the feed only ever needs to render "who did what".
model Activity {
  id        String       @id @default(uuid())
  actorId   String
  type      ActivityType
  modelId   String?
  createdAt DateTime     @default(now())

  actor User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  model Model3D? @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@map("activities")
}